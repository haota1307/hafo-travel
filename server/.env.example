NODE_ENV=development
GLOBAL_PREFIX=api
PORT=3300
USER_ACCESS_SERVICE_HOST=localhost
AUTHORIZER_SERVICE_HOST=localhost
AUTHORIZER_SERVICE_PORT=5100
USER_ACCESS_SERVICE_PORT=5101
GRPC_BIND_HOST=0.0.0.0
MONGODB_URL=mongodb://root:password@localhost:27017/?authSource=admin
MONGODB_DB_NAME=backend_app
KEYCLOAK_HOST=http://localhost:8180
KEYCLOAK_REALM=backend
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=replace-with-your-new-client-secret
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600
BOOTSTRAP_ADMIN_KEYCLOAK_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
# Optional PostgreSQL configuration for future modules
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=password
TYPEORM_DATABASE=backend_app
