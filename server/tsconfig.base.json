{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2023",
    "module": "nodenext",
    "lib": ["es2023"],
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@common/configuration/*": ["./libs/configuration/src/lib/*"],
      "@common/middlewares/*": ["./libs/middlewares/src/lib/*"],
      "@common/utils/*": ["./libs/utils/src/lib/*"],
      "@common/constants/*": ["./libs/constants/src/lib/*"],
      "@common/interfaces/*": ["./libs/interfaces/src/lib/*"],
      "@common/interceptors/*": ["./libs/interceptors/src/lib/*"],
      "@common/decorators/*": ["./libs/decorators/src/lib/*"],
      "@common/schemas/*": ["./libs/schemas/src/lib/*"],
      "@common/entities/*": ["./libs/entities/src/lib/*"],
      "@common/guards/*": ["./libs/guards/src/lib/*"],
      "@ai-agent/app": ["./apps/ai-agent/src/app/app.module.ts"],
      "@ai-agent/config": ["./apps/ai-agent/src/configuration/index.ts"],
      "@ai-agent/config/*": ["./apps/ai-agent/src/configuration/*"],
      "@ai-agent/*": ["./apps/ai-agent/src/app/modules/*"],
      "@bff/app": ["./apps/bff/src/app/app.module.ts"],
      "@bff/config": ["./apps/bff/src/configuration/index.ts"],
      "@bff/config/*": ["./apps/bff/src/configuration/*"],
      "@bff/*": ["./apps/bff/src/app/modules/*"],
      "@booking/app": ["./apps/booking/src/app/app.module.ts"],
      "@booking/config": ["./apps/booking/src/configuration/index.ts"],
      "@booking/config/*": ["./apps/booking/src/configuration/*"],
      "@booking/*": ["./apps/booking/src/app/modules/*"],
      "@identity/app": ["./apps/identity/src/app/app.module.ts"],
      "@identity/config": ["./apps/identity/src/configuration/index.ts"],
      "@identity/config/*": ["./apps/identity/src/configuration/*"],
      "@identity/*": ["./apps/identity/src/app/modules/*"],
      "@notification/app": ["./apps/notification/src/app/app.module.ts"],
      "@notification/config": [
        "./apps/notification/src/configuration/index.ts"
      ],
      "@notification/config/*": ["./apps/notification/src/configuration/*"],
      "@notification/*": ["./apps/notification/src/app/modules/notification/*"],
      "@payment/app": ["./apps/payment/src/app/app.module.ts"],
      "@payment/config": ["./apps/payment/src/configuration/index.ts"],
      "@payment/config/*": ["./apps/payment/src/configuration/*"],
      "@payment/*": ["./apps/payment/src/app/modules/*"]
    },
    "noUncheckedSideEffectImports": true,
    "types": ["node"],
    "esModuleInterop": true
  },
  "exclude": ["node_modules", "tmp"]
}
