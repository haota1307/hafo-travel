{
  "name": "@backend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "nx:reset": "nx reset",
    "nx:run-many": "nx run-many",
    "dev": "pnpm nx:reset && pnpm nx:run-many -t serve",
    "dev-lite": "pnpm dev --projects=bff,user-access,authorizer",
    "build": "nx run-many -t build --projects=bff,user-access,authorizer",
    "lint": "nx run-many -t lint",
    "typecheck": "node tools/typecheck.cjs",
    "proto:generate": "node tools/generate-proto.cjs",
    "test": "nx run-many -t test --projects=bff,authorizer,interceptors --runInBand"
  },
  "private": true,
  "dependencies": {
