{
  "name": "user-access",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/user-access/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--mode=production"],
        "cwd": "apps/user-access",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "configurations": {
        "development": {
          "args": ["--mode=development"],
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/user-access/package.json",
        "{workspaceRoot}/dist/apps/user-access/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/user-access/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/user-access/patches",
        "{workspaceRoot}/dist/apps/user-access/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ]
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/user-access/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "user-access:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "user-access:build:development"
        },
        "production": {
          "buildTarget": "user-access:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/seed.js apps/user-access/src/seeds migrate"
      }
    },
    "preview": {
      "options": {
        "args": ["--mode=production"],
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  }
}
