{
  "name": "payment",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/payment/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--mode=production"],
        "cwd": "apps/payment",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "configurations": {
        "development": {
          "args": ["--mode=development"],
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/payment/package.json",
        "{workspaceRoot}/dist/apps/payment/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('npm major '+require('child_process').execSync('npm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('npm major unavailable')}\""
        }
      ]
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/payment/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "payment:build",
        "runBuildTargetDependencies": false,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "payment:build:development"
        },
        "production": {
          "buildTarget": "payment:build:production"
        }
      }
    },
    "preview": {
      "options": {
        "args": ["--mode=production"],
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  }
}
